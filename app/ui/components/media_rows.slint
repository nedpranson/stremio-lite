import { Theme } from "../theme.slint";
import { ButtonSurface } from "button.slint";
import { FallbackImage } from "fallback_image.slint";
import { SkeletonBlock } from "feedback.slint";

export component StreamRow inherits Rectangle {
    in property <length> unit: 16px;
    in property <string> title;
    in property <string> description;
    in property <image> thumbnail;
    in property <bool> has-thumbnail: root.thumbnail.width > 0;
    in property <float> progress: 0;
    in property <bool> selected: false;
    callback play;
    callback context-requested(length, length);

    // Mirrors stremio-web's `.stream-container`: 8rem x 5rem artwork, 1rem
    // gaps, 0.5rem/1rem padding, and the overlay color on hover/focus.
    // No fixed height: the row grows so the full description is visible.
    height: content.preferred-height;
    out property <length> content-height: content.preferred-height;
    border-radius: Theme.border-radius;
    background: root.selected || area.has-hover ? Theme.overlay-color : transparent;

    animate background { duration: Theme.motion-fast; }

    accessible-role: button;
    accessible-label: root.title + " " + root.description;
    accessible-action-default => { root.play(); }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    content := Rectangle {
        width: parent.width;
        height: self.preferred-height;
        background: transparent;

        HorizontalLayout {
            padding-left: root.unit;
            padding-right: root.unit;
            padding-top: 0.5 * root.unit;
            padding-bottom: 0.5 * root.unit;
            spacing: root.unit;
            alignment: center;

            // Web's `.info-container`: artwork when the addon provided one, the
            // stream name otherwise, with the progress bar on the bottom edge.
            info := Rectangle {
                width: 8 * root.unit;
                height: 5 * root.unit;
                background: transparent;

                if (root.has-thumbnail) : FallbackImage {
                    width: parent.width;
                    height: parent.height;
                    source: root.thumbnail;
                    contain: false;
                    image-opacity: 0.9;
                    background-color: Theme.overlay-color;

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1.5 * root.unit;
                        height: 1.5 * root.unit;
                        source: @image-url("../assets/images/icons/link.svg");
                        colorize: Theme.primary-foreground;
                        opacity: 0.25;
                        image-fit: contain;
                    }
                }

                if (!root.has-thumbnail) : Text {
                    width: 7 * root.unit;
                    height: parent.height;
                    text: root.title;
                    color: Theme.primary-foreground;
                    font-size: 12.5px;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if (root.progress > 0) : Rectangle {
                    y: parent.height - 0.4 * root.unit;
                    width: parent.width;
                    height: 0.4 * root.unit;
                    background: Theme.primary-foreground.with-alpha(0.2);

                    Rectangle {
                        width: parent.width * root.progress.clamp(0, 1);
                        height: parent.height;
                        background: Theme.primary-accent;
                    }
                }
            }

            // Web's `.description-container`: a column that shows every line the
            // addon sent.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 0.2 * root.unit;

                Text {
                    text: root.description;
                    color: Theme.primary-foreground;
                    font-size: 12.5px;
                    wrap: no-wrap;
                    overflow: clip;
                    vertical-alignment: center;
                }
            }

            // Web's `.icon`: a 3rem circle in the secondary accent that fades in
            // on hover/focus/selection.
            icon := Rectangle {
                width: 3 * root.unit;
                height: 3 * root.unit;
                border-radius: self.width / 2;
                background: Theme.secondary-accent;
                opacity: root.selected || area.has-hover ? 1 : 0;

                animate opacity { duration: Theme.motion-fast; }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.6 * root.unit;
                    height: 1.6 * root.unit;
                    source: @image-url("../assets/images/icons/play.svg");
                    colorize: Theme.primary-foreground;
                    image-fit: contain;
                }
            }
        }
    }

}

export component EpisodeRow inherits Rectangle {
    in property <length> unit: 16px;
    in property <string> title;
    in property <string> released;
    in property <image> thumbnail;
    in property <int> episode-number;
    in property <bool> upcoming: false;
    in property <bool> watched: false;
    in property <bool> season-watched: false;
    in property <bool> scheduled: false;
    in property <bool> has-thumbnail: root.thumbnail.width > 0;
    in property <float> progress: 0;
    in property <bool> show-progress: root.progress > 0;
    in property <bool> blur-spoiler: false;
    in property <bool> selected-row: false;
    in property <bool> can-play: false;
    callback selected;
    callback play;
    callback toggle-watched;
    callback toggle-season-watched;
    callback context-requested;

    // 6rem of row plus the web's `margin-bottom: 0.5rem`, so consecutive rows
    // in a ListView are separated the way `.video-container` is.
    height: 6.5 * root.unit;
    background: transparent;
    private property <bool> selection-highlight: false;

    changed selected-row => {
        if (root.selected-row) {
            root.selection-highlight = true;
            selection-timer.restart();
        } else {
            root.selection-highlight = false;
            selection-timer.stop();
        }
    }

    selection-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.stop();
            root.selection-highlight = false;
        }
    }

    video-button := ButtonSurface {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 6 * root.unit;
        enabled: !root.upcoming;
        opacity: root.upcoming ? 0.45 : 1;
        border-radius: Theme.border-radius;
        border-width: 0.15 * root.unit;
        border-color: root.selection-highlight ? Theme.primary-accent : transparent;
        background: self.has-hover || self.has-focus || root.selected-row
        ? Theme.overlay-color
        : transparent;
        accessible-name: @tr("EPISODE" => "Episode") + " " + root.episode-number + " " + root.title;
        long-press-enabled: true;
        clicked => { root.selected(); }
        long-pressed => { root.context-requested(); }

        animate background { duration: Theme.motion-fast; }
        animate border-color { duration: Theme.motion-fast; easing: ease-in-out; }

        thumbnail-frame := Rectangle {
            visible: root.has-thumbnail;
            x: 0.5 * root.unit;
            y: 0.5 * root.unit;
            width: 8 * root.unit;
            height: 5 * root.unit;
            border-radius: 0.3 * root.unit;
            background: Theme.overlay-color;
            clip: true;

            FallbackImage {
                width: parent.width;
                height: parent.height;
                source: root.thumbnail;
                primary-available: root.thumbnail.width > 0;
                image-opacity: 0.9;
                background-color: Theme.overlay-color;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 3 * root.unit;
                    height: 3 * root.unit;
                    source: @image-url("../assets/images/icons/symbol.svg");
                    colorize: Theme.primary-foreground;
                    opacity: 0.25;
                    image-fit: contain;
                }
            }

            if (root.show-progress && root.has-thumbnail) : Rectangle {
                x: 0.5 * root.unit;
                y: parent.height - 0.9 * root.unit;
                width: parent.width - root.unit;
                height: 0.4 * root.unit;
                border-radius: Theme.border-radius;
                background: Theme.primary-foreground.with-alpha(0.2);
                clip: true;

                Rectangle {
                    x: 0px;
                    width: parent.width * max(0, min(100, root.progress)) / 100;
                    height: parent.height;
                    background: Theme.primary-accent;
                }
            }
        }

        info := Rectangle {
            x: root.has-thumbnail ? 10 * root.unit : root.unit;
            y: 0.5 * root.unit;
            width: parent.width - self.x - (root.can-play ? 4 * root.unit : 0.5 * root.unit);
            height: 5 * root.unit;
            background: transparent;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 2.4 * root.unit;
                text: (root.episode-number > 0 ? root.episode-number + ". " : "")
                + root.title;
                color: Theme.primary-foreground;
                font-size: root.unit;
                font-weight: 500;
                wrap: word-wrap;
                overflow: elide;
            }

            Text {
                x: 0px;
                y: 3.4 * root.unit;
                width: max(0px, parent.width - badges.width - 0.5 * root.unit);
                height: 1.2 * root.unit;
                text: root.released != "" ? root.released : (root.scheduled ? @tr("TBA" => "TBA") : "");
                color: Theme.primary-foreground;
                opacity: 0.44;
                font-size: 0.8 * root.unit;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }

            badges := Rectangle {
                x: parent.width - self.width;
                y: 3.2 * root.unit;
                width: (root.upcoming && !root.watched ? 6.5 * root.unit : 0px)
                + (root.watched ? 7.5 * root.unit : 0px)
                + (root.upcoming && root.watched ? 0.5 * root.unit : 0px);
                height: 1.6 * root.unit;
                background: transparent;

                if (root.upcoming && !root.watched) : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 6.5 * root.unit;
                    height: parent.height;
                    border-radius: 0.3 * root.unit;
                    background: Theme.secondary-accent.with-alpha(0.2);

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: @tr("UPCOMING" => "Upcoming");
                        color: Theme.secondary-accent;
                        font-size: 0.8 * root.unit;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if (root.watched) : watched-button := ButtonSurface {
                    x: parent.width - self.width;
                    y: 0px;
                    width: 7.5 * root.unit;
                    height: parent.height;
                    border-radius: 0.3 * root.unit;
                    background: Theme.tertiary-accent;
                    accessible-name: @tr("CTX_MARK_UNWATCHED" => "Mark as unwatched");
                    clicked => { root.toggle-watched(); }

                    HorizontalLayout {
                        padding-left: 0.5 * root.unit;
                        padding-right: 0.5 * root.unit;
                        spacing: 0.25 * root.unit;
                        alignment: center;

                        Image {
                            width: 1.15 * root.unit;
                            height: 1.15 * root.unit;
                            source: @image-url("../assets/images/icons/eye.svg");
                            colorize: Theme.secondary-foreground;
                            image-fit: contain;
                        }
                        Text {
                            text: @tr("WATCHED" => "Watched");
                            color: Theme.secondary-foreground;
                            font-size: 0.8 * root.unit;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        if (root.can-play) : saved-stream-play-button := ButtonSurface {
            x: parent.width - self.width - 0.5 * root.unit;
            y: 1.5 * root.unit;
            width: 3 * root.unit;
            height: 3 * root.unit;
            border-radius: self.width / 2;
            background: self.has-hover || self.has-focus
            ? Theme.secondary-accent
            : Theme.overlay-color;
            accessible-name: @tr("CTX_WATCH" => "Watch");
            clicked => { root.play(); }

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.5 * root.unit;
                height: 1.5 * root.unit;
                source: @image-url("../assets/images/icons/play.svg");
                colorize: Theme.primary-foreground;
                image-fit: contain;
            }
        }
    }

    // The web Video component exposes these actions from every episode row.
    // Use the platform-native menu so right-click behavior, dismissal, and
    // keyboard navigation remain consistent with the host OS.
    ContextMenuArea {
        width: parent.width;
        height: 6 * root.unit;

        Menu {
            MenuItem {
                title: @tr("CTX_WATCH" => "Watch");
                activated => {
                    if (root.can-play) {
                        root.play();
                    } else {
                        root.selected();
                    }
                }
            }
            MenuItem {
                title: root.watched
                ? @tr("CTX_MARK_NON_WATCHED" => "Mark as unwatched")
                : @tr("CTX_MARK_WATCHED" => "Mark as watched");
                activated => { root.toggle-watched(); }
            }
            MenuItem {
                title: root.season-watched
                ? @tr("CTX_UNMARK_REST" => "Mark rest as unwatched")
                : @tr("CTX_MARK_REST" => "Mark rest as watched");
                activated => { root.toggle-season-watched(); }
            }
        }
    }
}

// Public name retained from stremio-web. EpisodeRow remains as a descriptive
// compatibility name for existing native call sites.
export component Video inherits EpisodeRow { }

export component VideoPlaceholder inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <bool> has-thumbnail: false;

    private property <length> info-x: root.has-thumbnail ? 10 * root.unit : root.unit;
    private property <length> info-width: max(0px, root.width - root.info-x - root.unit);

    height: 6.5 * root.unit;
    background: transparent;

    if (root.has-thumbnail) : SkeletonBlock {
        x: 0.5 * root.unit;
        y: 0.5 * root.unit;
        width: 8 * root.unit;
        height: 5 * root.unit;
        radius: 0.3 * root.unit;
    }

    SkeletonBlock {
        x: root.info-x;
        y: 0.75 * root.unit;
        width: root.info-width * 0.8;
        height: 1.2 * root.unit;
    }

    SkeletonBlock {
        x: root.info-x;
        y: 3.75 * root.unit;
        width: root.info-width;
        height: root.unit;
    }
}
